# --- database ---
# Port 5433 — see the comment in docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://evidwell:evidwell@localhost:5433/evidwell

# --- auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-at-least-32-characters-long-please

# --- Claude ---
ANTHROPIC_API_KEY=

# A model per job — see DESIGN.md §3.6. Defaults shown; uncomment to override.
# Raise SYNTHESIS_MODEL to claude-opus-5 if drafts start failing validation.
# EXTRACTION_MODEL=claude-haiku-4-5
# SYNTHESIS_MODEL=claude-sonnet-5

# --- embeddings ---
# Changing provider or dimension after the cache has rows requires a re-embed
# AND a migration. See DESIGN.md §3.5.
EMBEDDING_PROVIDER=voyage
EMBEDDING_DIM=1024
VOYAGE_API_KEY=
OPENAI_API_KEY=

# --- scholarly providers ---
# Which APIs retrieval fans out across. Comma-separated; the code default is
# `pubmed` alone. Every enabled provider is queried for every claim and the
# results are merged per paper (retrieve.py::_dedup), so adding one raises
# recall and metadata quality rather than just adding duplicates.
#   pubmed           — best study-type metadata; the grade bonus depends on it
#   openalex         — broad coverage, weak study typing (single `type` string)
#   europe_pmc       — no key required, so it is free recall
#   semantic_scholar — returns nothing at all without an API key, by design
ENABLED_PROVIDERS=pubmed,openalex

# Optional but strongly recommended: raises PubMed from 3 to 10 req/s.
PUBMED_API_KEY=
# Not optional if semantic_scholar is enabled — the provider skips itself
# entirely when this is blank rather than burning retries on 429s.
SEMANTIC_SCHOLAR_API_KEY=
# OpenAlex polite pool — just an email address, materially better latency.
OPENALEX_MAILTO=

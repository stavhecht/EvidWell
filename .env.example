# --- database ---
DATABASE_URL=postgresql+asyncpg://evidwell:evidwell@localhost:5432/evidwell

# --- auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-at-least-32-characters-long-please

# --- Claude ---
ANTHROPIC_API_KEY=

# --- embeddings ---
# Changing provider or dimension after the cache has rows requires a re-embed
# AND a migration. See DESIGN.md §3.5.
EMBEDDING_PROVIDER=voyage
EMBEDDING_DIM=1024
VOYAGE_API_KEY=
OPENAI_API_KEY=

# --- scholarly providers ---
# Optional but strongly recommended: raises PubMed from 3 to 10 req/s.
PUBMED_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
# OpenAlex polite pool — just an email address, materially better latency.
OPENALEX_MAILTO=
